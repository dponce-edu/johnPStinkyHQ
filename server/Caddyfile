# Caddy config for Club Escapade on the Pi.
# Copy to /etc/caddy/Caddyfile, replace the domain, then: sudo systemctl reload caddy
# Caddy gets and renews the HTTPS certificate on its own.

clubescapade.example.com {
	root * /srv/club-escapade/site
	encode zstd gzip

	# Accounts, comments and ratings: server/app.py
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		# Every file needs a log-in. Caddy asks app.py first, and anyone not
		# logged in is redirected to /login.html. The few files the log-in
		# page itself needs are listed in PUBLIC_PATHS in server/app.py, so
		# there's one list and one place that decides.
		forward_auth 127.0.0.1:8080 {
			uri /api/auth-check
		}
		# Browsers must check with the server before reusing a cached page or
		# game, so nothing is reachable from the cache after logging out.
		# Unchanged files still aren't downloaded again (304 Not Modified).
		header Cache-Control "no-cache"
		# The repo checkout holds files that must never be public. "hide"
		# checks the actual file, so odd URLs like /./server/ can't get past it.
		file_server {
			hide .git .gitignore server data
		}
	}

	header {
		# Pages, and the Flash games in them, may only load from this site and
		# the Ruffle CDN. This blocks the old ad networks and trackers built
		# into many .swf files. Keep in step with CSP in server/app.py.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://unpkg.com; connect-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# A second site on the same Pi, e.g. your personal site:
#
# yourname.example.com {
# 	root * /srv/personal-site
# 	file_server
# }
